/*
 * mona2.keymap — generated by moNa2 Studio
 * 公式ファームウェア (sayu-hub/zmk-config-moNa2-v2) の config/mona2.keymap を、このファイルで丸ごと置き換えます。
 * 配列: 42キー / 行構成 10・11・12・9 (公式ファームウェアの matrix transform 順)
 */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
                &kp Q             &kp W             &kp E             &kp R             &kp T             &kp Y             &kp U             &kp I             &kp O             &kp P
                &kp A             &kp S             &kp D             &kp F             &kp G             &kp RBKT          &kp H             &kp J             &kp K             &kp L             &kp MINUS
                &kp Z             &kp X             &kp C             &kp V             &kp B             &kp GRAVE         &kp SQT           &kp N             &kp M             &kp COMMA         &kp DOT           &kp FSLH
                &trans            &kp ESC           &kp LALT          &kp LGUI          &lt 1 SPACE       &mt LSHIFT LANG2  &lt 2 ENTER       &kp BSPC          &mt RSHIFT LANG1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            display-name = "NUM";
            bindings = <
                &kp N1            &kp N2            &kp N3            &kp N4            &kp N5            &kp N6            &kp N7            &kp N8            &kp N9            &kp N0
                &trans            &trans            &trans            &trans            &kp HOME          &trans            &kp LEFT          &kp DOWN          &kp UP            &kp RIGHT         &kp END
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &kp DEL           &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        layer_2 {
            display-name = "SYM";
            bindings = <
                &kp EXCL          &kp AT            &kp HASH          &kp DLLR          &kp PRCNT         &kp CARET         &kp AMPS          &kp STAR          &kp LPAR          &kp RPAR
                &trans            &trans            &trans            &trans            &trans            &kp EQUAL         &kp UNDER         &kp PLUS          &kp LBRC          &kp RBRC          &kp PIPE
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            display-name = "FUN";
            bindings = <
                &kp F1            &kp F2            &kp F3            &kp F4            &kp F5            &kp F6            &kp F7            &kp F8            &kp F9            &kp F10
                &kp F11           &kp F12           &trans            &trans            &trans            &trans            &kp C_PREV        &kp C_VOL_DN      &kp C_VOL_UP      &kp C_NEXT        &kp C_PP
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        layer_4 {
            display-name = "BLE";
            bindings = <
                &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2      &bt BT_SEL 3      &bt BT_CLR        &trans            &trans            &trans            &trans            &trans
                &bootloader       &sys_reset        &studio_unlock    &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_5 {
            display-name = "SCROLL";
            bindings = <
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_6 {
            display-name = "MOUSE";
            bindings = <
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &mkp LCLK         &mkp RCLK         &mkp MCLK         &mkp MB4          &mkp MB5
                &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans            &trans
                &trans            &trans            &trans            &trans            &trans            &trans            &mkp LCLK         &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

/* トラックボール (moNa2 Studio の設定。公式の mona2_r.overlay / mona2.dtsi の値を上書き) */
&trackball_central_listener {
    input-processors =
        <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
        <&zip_xy_scaler 4 3>,
        <&zip_temp_layer 6 700>;

    scroller {
        layers = <5>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_scroll_scaler 1 5>;
    };
};
