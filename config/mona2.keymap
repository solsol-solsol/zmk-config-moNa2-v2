/*
 * mona2.keymap — generated by moNa2 Studio
 * 公式ファームウェア (sayu-hub/zmk-config-moNa2-v2) の config/mona2.keymap を、このファイルで丸ごと置き換えます。
 * 配列: 42キー / 行構成 10・11・12・9 (公式ファームウェアの matrix transform 順)
 */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    mona2_macros {
        mona2_macro_1: mona2_macro_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Fpass";
            wait-ms = <15>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp LS(F)>
                , <&macro_tap &kp J>
                , <&macro_tap &kp K>
                , <&macro_tap &kp L>
                , <&macro_tap &kp N0>
                , <&macro_tap &kp N1>
                , <&macro_tap &kp N7>
                , <&macro_tap &kp N0>
                , <&macro_tap &kp N1>
                , <&macro_tap &kp N6>
                , <&macro_tap &kp SEMI>
                ;
        };
        mona2_macro_2: mona2_macro_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "( + )";
            wait-ms = <15>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp LPAR>
                , <&macro_tap &kp RPAR>
                ;
        };
        mona2_macro_3: mona2_macro_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "[ + ]";
            wait-ms = <15>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp LBKT>
                , <&macro_tap &kp RBKT>
                ;
        };
        mona2_macro_4: mona2_macro_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "{ + }";
            wait-ms = <15>;
            tap-ms = <30>;
            bindings
                = <&macro_tap &kp LBRC>
                , <&macro_tap &kp RBRC>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_1 {
            timeout-ms = <50>;
            key-positions = <17 18 19>;
            bindings = <&mona2_macro_1>;
            layers = <0>;
        };
        combo_2 {
            timeout-ms = <50>;
            key-positions = <0 36>;
            bindings = <&to 1>;
            layers = <0>;
        };
        combo_3 {
            timeout-ms = <50>;
            key-positions = <1 36>;
            bindings = <&to 2>;
            layers = <0>;
        };
        combo_4 {
            timeout-ms = <50>;
            key-positions = <2 36>;
            bindings = <&to 3>;
            layers = <0>;
        };
        combo_5 {
            timeout-ms = <50>;
            key-positions = <3 36>;
            bindings = <&to 4>;
            layers = <0>;
        };
        combo_6 {
            timeout-ms = <50>;
            key-positions = <38 39>;
            bindings = <&to 0>;
            layers = <1 2 3 4>;
        };
    };
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "BASE";
            bindings = <
                &kp Q            &kp W            &kp E            &kp R            &kp T            &kp Y            &kp U            &kp I            &kp O            &kp P
                &kp A            &kp S            &kp D            &kp F            &kp G            &none            &kp H            &kp J            &kp K            &kp L            &kp COLON
                &mt LSHIFT Z     &kp X            &kp C            &kp V            &kp B            &kp TAB          &none            &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH
                &mt LCTRL ESC    &kp LGUI         &kp RALT         &kp DEL          &kp ENTER        &lt 4 LA(GRAVE)  &kp SPACE        &kp BSPC         &mt RSHIFT RALT
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            display-name = "NUM";
            bindings = <
                &kp N1           &kp N2           &kp N3           &kp N4           &kp N5           &none            &mona2_macro_2   &kp FSLH         &none            &none
                &kp N6           &kp N7           &kp N8           &kp N9           &kp N0           &none            &none            &mona2_macro_3   &kp PIPE         &none            &none
                &none            &none            &none            &none            &none            &none            &none            &none            &mona2_macro_4   &kp BSLH         &none            &none
                &none            &none            &none            &none            &none            &none            &none            &none            &none
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            display-name = "SYM";
            bindings = <
                &kp EXCL         &kp AT           &kp HASH         &kp DLLR         &kp PRCNT        &kp CARET        &kp AMPS         &kp STAR         &kp MINUS        &kp UNDER
                &kp GRAVE        &kp TILDE        &kp DQT          &kp SQT          &none            &none            &none            &none            &none            &kp EQUAL        &kp PLUS
                &kp F1           &kp F2           &kp F3           &kp F4           &kp F5           &kp F11          &kp F12          &kp F6           &kp F7           &kp F8           &kp F9           &kp F10
                &none            &none            &none            &none            &none            &none            &none            &none            &none
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            display-name = "FUN";
            bindings = <
                &none            &none            &none            &none            &none            &kp LC(C)        &none            &kp UP           &none            &none
                &none            &none            &none            &kp LG(LS(S))    &kp LS(F6)       &none            &kp LC(V)        &kp LEFT         &kp DOWN         &kp RIGHT        &none
                &none            &none            &none            &none            &none            &none            &none            &kp BSPC         &none            &none            &none            &none
                &none            &none            &none            &none            &none            &none            &none            &none            &none
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_4 {
            display-name = "MOUSE";
            bindings = <
                &none            &none            &none            &none            &none            &kp LC(X)        &mkp MCLK        &none            &none            &none
                &none            &none            &none            &none            &none            &none            &kp LC(C)        &mkp LCLK        &mkp RCLK        &none            &none
                &none            &none            &none            &none            &none            &none            &none            &kp LC(V)        &mo 5            &none            &none            &none
                &none            &none            &none            &none            &none            &none            &none            &none            &none
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        layer_5 {
            display-name = "SCROLL";
            bindings = <
                &none            &none            &none            &none            &none            &none            &none            &none            &none            &none
                &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &none
                &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &none            &none
                &none            &none            &none            &none            &none            &none            &none            &none            &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};

/* トラックボール (moNa2 Studio の設定。公式の mona2_r.overlay / mona2.dtsi の値を上書き) */
&trackball_central_listener {
    input-processors =
        <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
        <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
        <&zip_xy_scaler 4 3>,
        <&zip_temp_layer 4 700>;

    scroller {
        layers = <5>;
        input-processors =
            <&zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)>,
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_xy_to_scroll_mapper>,
            <&zip_scroll_transform INPUT_TRANSFORM_X_INVERT>,
            <&zip_scroll_scaler 1 5>;
    };
};

/* スリープから、キーを押して起きられるようにする (moNa2 Studio の設定) */
&kscan0 {
    wakeup-source;
};
